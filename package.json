{
  "name": "thirdstopsajin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build --force && node scripts/check-dist.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check-photos": "sh scripts/check-photos.sh",
    "test": "node tests/posts.mjs && sh tests/photos.sh",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "7.4.0",
    "sharp": "0.35.5"
  }
}
