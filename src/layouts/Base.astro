---
import { localize, otherLang, ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  // The same page in the other language, when it exists.
  otherUrl?: string;
}

const { lang, title, description, otherUrl } = Astro.props;
const t = ui[lang];
const other = otherLang(lang);
const pageTitle = title ? `${title} · ${t.siteName}` : t.siteName;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="site">
      <a class="name" href={localize(lang, '/')}>{t.siteName}</a>
      <a href={otherUrl ?? localize(other, '/')} hreflang={other} lang={other}>{ui[other].ownName}</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #6b6b6b;
    --rule: #e2e2e2;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121212;
      --fg: #e8e8e8;
      --muted: #9a9a9a;
      --rule: #2e2e2e;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 17px/1.65 system-ui, -apple-system, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
    -webkit-text-size-adjust: 100%;
  }
  :lang(ko) {
    word-break: keep-all;
  }
  a {
    color: inherit;
  }
  header.site,
  main {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  header.site {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 1.25rem;
    padding-bottom: 2rem;
  }
  header.site .name {
    font-weight: 600;
    text-decoration: none;
  }
  main {
    padding-bottom: 4rem;
  }
  h1 {
    font-size: 1.6rem;
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }
  h2 {
    font-size: 1.15rem;
    margin: 2.5rem 0 1rem;
  }
  img {
    max-width: 100%;
    height: auto;
  }
  .muted {
    color: var(--muted);
  }
  .tag {
    font-size: 0.8em;
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
    padding: 0 0.3rem;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
