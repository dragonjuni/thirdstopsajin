---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { langParam, langs, localize, otherLang, ui, type Lang } from '../../lib/i18n';
import { allPosts, forLang, topStories } from '../../lib/posts';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang: langParam(lang) }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const posts = forLang(await allPosts(), lang);
// Top stories first, in the owner's order; everything else below, newest first.
const top = topStories(posts);
const recent = posts.filter((post) => !top.includes(post));
---

<Base lang={lang} otherUrl={localize(otherLang(lang), '/')}>
  {posts.length === 0 && <p class="muted">{t.nothingYet}</p>}
  {
    top.length > 0 && (
      <section>
        <h2>{t.topStories}</h2>
        <PostList posts={top} lang={lang} />
      </section>
    )
  }
  {
    recent.length > 0 && (
      <section>
        {top.length > 0 && <h2>{t.recent}</h2>}
        <PostList posts={recent} lang={lang} />
      </section>
    )
  }
</Base>
